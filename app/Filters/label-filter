#!/bin/bash
set -euo pipefail
if [ "$#" -lt 5 ] || [ "$#" -gt 6 ] || [ ! -r "${PPD:-}" ]; then
    printf 'ERROR: Printer Studio KH label filter needs CUPS arguments and a readable PPD.\n' >&2
    exit 1
fi
BASE="${0%/*}"
vendor=$(/usr/bin/awk -F '"' '/^\*PrinterStudioVendorFilter:/ { print $2; exit }' "$PPD")
case "$vendor" in
    /Library/Printers/TSC/Filter/rastertobarcodetspl) ;;
    rastertosnailtspl-xprinter) vendor="${CUPS_SERVERBIN:-/usr/libexec/cups}/filter/$vendor" ;;
    *) printf 'ERROR: Printer Studio KH label filter refuses an unsupported vendor route.\n' >&2; exit 1 ;;
esac
if [ ! -x "$vendor" ]; then
    printf 'ERROR: Printer Studio KH label driver is missing or not executable: %s\n' "$vendor" >&2
    exit 1
fi
options=$("$BASE/label-options" "$5") || exit 1
pdftoraster() {
    CONTENT_TYPE=application/pdf FINAL_CONTENT_TYPE=application/vnd.cups-raster \
        /usr/libexec/cups/filter/cgpdftoraster "$1" "$2" "$3" "$4" "$options" "${@:6}"
}
case "${0##*/}" in
    label-urf)
        "$BASE/urftopdf" "$1" "$2" "$3" "$4" "$options" "${@:6}" \
            | pdftoraster "$1" "$2" "$3" "$4" \
            | CONTENT_TYPE=application/vnd.cups-raster FINAL_CONTENT_TYPE=application/vnd.cups-raw "$vendor" "$1" "$2" "$3" "$4" "$options"
        ;;
    label-pdf)
        pdftoraster "$@" | CONTENT_TYPE=application/vnd.cups-raster FINAL_CONTENT_TYPE=application/vnd.cups-raw "$vendor" "$1" "$2" "$3" "$4" "$options"
        ;;
    *) printf 'ERROR: Printer Studio KH label filter was invoked through an unknown route.\n' >&2; exit 1 ;;
esac
